# 서버 포트
PORT=4000

# ---------------------------------------------------------------------------
# 1) 행정안전부 도로명주소 API (주소 검색/정제용)
#    신청: https://www.juso.go.kr/addrlink/openApi/apiEasyGuide.do
#    -> "오픈API 신청" 후 발급받은 승인키(confmKey)를 입력
# ---------------------------------------------------------------------------
JUSO_API_KEY=

# ---------------------------------------------------------------------------
# 2) 공공데이터포털 - 국토교통부 건축물대장정보 서비스 (건물유형/사용승인일)
#    신청: https://www.data.go.kr/data/15057200/openapi.do
#    (검색창에 "건축물대장정보 서비스" 검색 -> 활용신청 -> 일반 인증키(Decoding) 사용)
#    아래 이름 중 아무거나 하나만 채우면 인식됩니다 (여러 개 채워도 무방, 위에서부터 우선순위).
# ---------------------------------------------------------------------------
BUILDING_REGISTER_API_KEY=
PUBLIC_DATA_API_KEY=
DATA_GO_KR_API_KEY=

# ---------------------------------------------------------------------------
# 3) 네이버 검색 오픈API (뉴스/블로그 - 재건축/재개발 관련 정보)
#    신청: https://developers.naver.com/apps/#/register
#    -> "검색" API 선택 후 발급받은 Client ID / Client Secret 입력
# ---------------------------------------------------------------------------
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# 4) (선택, 서울만 지원) 공공데이터포털 - 서울특별시_서울시 정비사업 데이터
#    신청: https://www.data.go.kr/data/15097425/fileData.do -> 활용신청
#    승인 후 "마이페이지 > 개발계정 상세보기"에 나오는 정확한 Request URL을
#    SEOUL_REDEVELOPMENT_API_URL 에 붙여넣어 주세요 (기본값은 추정값이라 다를 수 있음).
#    ⚠️ 조합설립인가일/사업시행인가일/관리처분계획인가일이 각각 나오지 않고
#    "현재 단계"+"그 단계의 고시일" 1건만 제공됩니다. 미채우면 이 기능만 비활성화됩니다.
# ---------------------------------------------------------------------------
SEOUL_REDEVELOPMENT_API_KEY=
SEOUL_REDEVELOPMENT_API_URL=

# ---------------------------------------------------------------------------
# 5) (선택, 부산만 지원) 공공데이터포털 - 부산광역시_정비사업 정보
#    신청: https://www.data.go.kr/data/3069406/openapi.do -> 활용신청
#    ⚠️ 조합설립인가일/사업시행인가일/관리처분계획인가일 없음 - "사업추진단계" 텍스트만.
#    ⚠️ 주소 조회 파라미터가 없어 전체 목록에서 위치 텍스트로 매칭 (서울보다 정확도 낮음).
#    미채우면 이 기능만 비활성화되고 나머지는 그대로 동작합니다.
# ---------------------------------------------------------------------------
BUSAN_REDEVELOPMENT_API_KEY=

# ---------------------------------------------------------------------------
# 6) (선택, 인천만 지원) 공공데이터포털 - 인천광역시_도시 및 주거환경 정비사업 추진현황
#    신청: https://www.data.go.kr/data/15055212/fileData.do -> 활용신청
#    ⚠️ 매월 새 파일이 올라올 때마다 UDDI가 통째로 바뀐다 - 코드가 매번 최신 UDDI를
#    자동으로 찾아 쓰므로(30일 캐시) 이 URL은 따로 설정할 필요 없다.
#    ⚠️ 조합설립인가일/사업시행인가일/관리처분계획인가일 없음 - "진행단계" 텍스트만.
#    미채우면 이 기능만 비활성화됩니다.
# ---------------------------------------------------------------------------
INCHEON_REDEVELOPMENT_API_KEY=

# ---------------------------------------------------------------------------
# 7) (선택, 경기도만 지원) 경기데이터드림 - 일반 정비 사업 추진 현황
#    신청: https://data.gg.go.kr 로그인 -> 마이페이지 -> 인증키발급
#    (data.go.kr 계정과는 별개의 키입니다)
#    ✅ 조합설립인가일/사업시행인가일/관리처분인가일/착공일/준공일/이전고시일까지
#    개별 필드로 제공 - 서울/부산/인천보다 상세함.
#    미채우면 이 기능만 비활성화됩니다.
# ---------------------------------------------------------------------------
GYEONGGI_REDEVELOPMENT_API_KEY=

# ---------------------------------------------------------------------------
# 8) (선택, 전국) 공공데이터포털 - 한국부동산원_청약홈 분양정보 조회 서비스
#    신청: https://www.data.go.kr/data/15098547/openapi.do -> 활용신청
#    ✅ 지역 제한 없이 전국 아파트의 "청약 당첨자발표일(청약당첨일/분양일)"을 채워준다.
#    ⚠️ "청약(공개분양) 절차를 거친 단지"만 있음 - 100% 조합원 물량 재건축이나
#    2022-01 청약홈 등록 이전 단지는 없을 수 있음 ("100% 커버"는 아님).
#    미채우면 이 기능만 비활성화되고 네이버 검색 기반 추정치만 표시됩니다.
# ---------------------------------------------------------------------------
CHEONGYAK_API_KEY=

# ---------------------------------------------------------------------------
# 9) (선택, 전국) Gemini API - AI 실시간 웹검색 최후 폴백 (무료)
#    발급: https://aistudio.google.com/apikey -> 구글 계정만 있으면 됨, 카드 등록 불필요
#    ✅ 지역별 공식 API + 청약홈 + 네이버 텍스트마이닝까지 전부 확인했는데도 빈 항목이
#    남아있을 때만 자동 호출됩니다(단지명이 있는 경우만). Gemini 2.5 Flash-Lite 무료
#    티어(하루 500건)의 실시간 웹검색으로 조합설립인가일/사업시행인가일/관리처분인가일/
#    청약당첨일/조합원승계일을 찾고, 출처 링크도 함께 받습니다.
#    ⚠️ 출처 URL이 확인되지 않는 날짜는 절대 표시하지 않도록 서버에서 검증합니다.
#    ⚠️ 2026-08: gemini-2.5-flash가 신규 API 키에서 막히는 문제가 확인되어(공식
#    지원종료일 2026-10-16보다 이른 선제 차단) flash-lite로 교체했습니다. 같은 세대라
#    이것도 언제든 막힐 수 있어, GEMINI_MODEL 을 채우면 재배포 없이 모델을 바꿀 수
#    있습니다(단, 3.x 계열은 무료 티어에 웹검색이 없어 결제가 필요합니다).
#    미채우면 이 기능만 비활성화되고 나머지는 그대로 동작합니다.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# 전국 커버리지 관련 안내
# 전국 통합 "재건축·재개발 정비구역 정보 API"는 존재하지 않습니다 (확인 완료).
# 지자체마다 다른 포털/다른 구조로 각자 등록되어 있어, 서울/부산처럼 지역별로
# 하나씩 확인 후 server/services/regionalRedevelopmentService.js 에 추가해야 합니다.
# 다른 지역이 필요하면 어느 지역이 우선인지 알려주세요.
# ---------------------------------------------------------------------------
